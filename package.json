{
  "name": "briefy-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:debug:sandbox-dmg": "bash scripts/build-macos-debug-sandbox-dmg.sh",
    "tauri:build:mac:release-dmg": "bash scripts/build-macos-release-dmg.sh",
    "tauri:build:windows:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-debug-bundle.ps1",
    "tauri:build:windows:release": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-release-bundle.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.10"
  }
}
